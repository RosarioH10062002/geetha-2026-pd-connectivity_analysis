@article{stephan_laminar_2019,
	title = {Laminar {fMRI} and computational theories of brain function},
	volume = {197},
	issn = {10538119},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1053811917309084},
	doi = {10.1016/j.neuroimage.2017.11.001},
	abstract = {Recently developed methods for functional MRI at the resolution of cortical layers (laminar fMRI) offer a novel window into neurophysiological mechanisms of cortical activity. Beyond physiology, laminar fMRI also offers an unprecedented opportunity to test inﬂuential theories of brain function. Speciﬁcally, hierarchical Bayesian theories of brain function, such as predictive coding, assign speciﬁc computational roles to different cortical layers. Combined with computational models, laminar fMRI offers a unique opportunity to test these proposals noninvasively in humans.},
	language = {en},
	urldate = {2026-03-26},
	journal = {NeuroImage},
	author = {Stephan, K.E. and Petzschner, F.H. and Kasper, L. and Bayer, J. and Wellstein, K.V. and Stefanics, G. and Pruessmann, K.P. and Heinzle, J.},
	month = aug,
