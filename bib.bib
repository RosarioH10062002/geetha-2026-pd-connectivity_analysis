@article{prasetyo_effect_2025,
	title = {The {Effect} of {Using} {Isochronic} {Tones} in {Improving} {Learning} {Concentration}: {Experimental} {Study} on {Students} of {State} {Senior} {High} {School} in {Jakarta}},
	volume = {5},
	issn = {09767797},
	shorttitle = {The {Effect} of {Using} {Isochronic} {Tones} in {Improving} {Learning} {Concentration}},
	url = {https://cognizancejournal.com/vol5issue3/V5I321.pdf},
	doi = {10.47760/cognizance.2025.v05i03.014},
	abstract = {Isochronic tones are sound waves used as brainwave entrainment to manipulate the dominant brainwave frequencies, thus influencing modulation of human responses and neurophysiology, common types of isochronic tones include theta, alpha, beta, delta, and gamma, each with varying effect on dominant brainwave frequencies. Isochronic tones are recognized to enhance sustained attention or concentration for cognitive task such as learning. Individuals naturally have varying levels of concentration. The initial assumption or hypothesis of this research is that alpha, beta, and gamma isochronic tones have a significant impact on an individual’s sustained attention or concentration. To test this hypothesis, we conducted a study involving 60 highschool students from SMA Negeri 6 Jakarta, who were divided into four groups, including three experimental groups and one control group. Respondents underwent the Sustained Attention to Response Task (SART) to measure their level of sustained attention. Respondents completed the SART at two different times : pretest and posttest. After the pretest, the experimental groups were subjected to a 10-minute intervention involving listening to isochronic tones, while the control group was provided with placebo effect (mute audio). After conducting repeated measure analysis of variance, it can be concluded that isochronic tones effectively and significantly enhance concentration, with gamma isochronic tones (30-100 Hz) having the most significant effect, with an average SART score increase of 10.06.},
	language = {en},
	number = {3},
	urldate = {2025-09-30},
	journal = {Cognizance Journal of Multidisciplinary Studies},
	author = {Prasetyo, Fery and Hermansyah, Eka and Putra, Dimas Ilham and Windiyani, Amanda Mayna},
	month = mar,
	year = {2025},
	keywords = {Isochron, LR2, notion},
	pages = {167--173},
}

@article{kanzler_effects_2023,
	title = {Effects of acoustic neurostimulation in healthy adults on symptoms of depression, anxiety, stress and sleep quality: a randomized clinical study},
	shorttitle = {Effects of acoustic neurostimulation in healthy adults on symptoms of depression, anxiety, stress and sleep quality},
	url = {https://www.explorationpub.com/Journals/ent/Article/100464},
	doi = {10.37349/ent.2023.00064},
	abstract = {Methods: A randomized, single-blind, parallel-group clinical trial, using acoustic neurostimulation with binaural beats, isochronic tones, or a combination of these in the 10 Hz range (alpha) performed with daily 20-minute sessions for 21 days. Changes in brainwave patterns were assessed by electroencephalogram (EEG). Psycho-emotional state was assessed with the Depression, Anxiety and Stress Scale 21 Items (DASS21), and sleep quality with the Pittsburgh Sleep Quality Index (PSQI). In addition, salivary cortisol levels were evaluated as a biomarker of stress.
Results: The data revealed distinct patterns of brainwave modulation via brainwave entrainment (BWE) techniques. Binaural beats and isochronic tones, alone and in combination, effectively increased alpha brainwaves in the temporoparietal region. However, when assessing theta brainwave frequencies in the same region, only binaural beats showed a significant effect. Furthermore, in the prefrontal cortex, an elevation in beta waves was exclusively observed with the use of binaural beats. These findings underscore the specificity of BWE techniques on different brainwave frequencies and regions. The study demonstrated marked improvements in several symptoms related to stress, depression, anxiety, assessed by psychometry with DASS-21 and related to sleep quality assessed by the PSQI.
Conclusions: These results indicate that 10 Hz acoustic neurostimulation in the alpha range, whether through binaural beats, isochronic tones, or a combination of both, can significantly influence brainwave},
	language = {en},
	urldate = {2025-10-20},
	journal = {Exploration of Neuroprotective Therapy},
	author = {Kanzler, Sandro A. and Cidral-Filho, Francisco J. and Kuerten, Beatriz and Prediger, Rui Daniel},
	month = dec,
	year = {2023},
	keywords = {Isochron, LR, LR2},
	pages = {481--496},
}

@article{engelbregt_effects_2019,
	title = {The {Effects} of {Binaural} and {Monoaural} {Beat} {Stimulation} on {Cognitive} {Functioning} in {Subjects} with {Different} {Levels} of {Emotionality}},
	volume = {15},
	issn = {1895-1171},
	url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC7204407/},
	doi = {10.5709/acp-0268-8},
	abstract = {Today, binaural and monaural beats are offered over the Internet or by mental health institutes to improve wellbeing or cognitive functioning. This improvement is explained by the assumption that the brain adapts its brainwave frequency to the frequency of the auditory beat. The present study examined the effects of binaural and monaural beat stimulation on attention and working memory in high and low emotional participants. A group of 24 participants (16 females, 8 males) between 19 and 31 years old (M = 22.33, SD = 3.42) performed a Flanker task to measure attention and a Klingberg task to measure working memory while listening to white noise (WN), 40 Hz gamma binaural beat (BB) and 40 Hz gamma monaural beat (MB). Speed of performance on all three levels of difficulty of the Flanker attention task was faster under the BB and MB condition than under WN. No differences were found between BB and MB conditions. With respect to the quality of performance on the Flanker attention task and the Klingberg working memory task no significant differences under the WN, MB, and BB condition were found. Finally, as participants with low or high emotionality did not respond differently to BB and MB under any of the conditions, effects of BB and MB seem similar in high and low emotional participants. The present study supports the notion that faster attention processing may equally be attributed to the influence of BB and MB. Further research is recommended to gain more insight in the role of factors such as duration of stimulation of BB and MB, frequency range, most appropriate carrier tones, and the role of personality traits.},
	number = {3},
	urldate = {2025-10-20},
	journal = {Advances in Cognitive Psychology},
	author = {Engelbregt, Hessel and Meijburg, Nora and Schulten, Marjolein and Pogarell, Oliver and Deijen, Jan Berend},
	month = aug,
	year = {2019},
	keywords = {LR, LR2},
	pages = {199--207},
}

